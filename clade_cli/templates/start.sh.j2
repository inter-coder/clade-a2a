#!/bin/bash
# Clade A2A daemon start script for peer '{{ peer.peer_id }}'
# Generated by Clade Setup Server.

set -e
cd "$(dirname "$0")"

CLADE_REPO_DIR="${CLADE_REPO_DIR:-/opt/clade-a2a}"
CLADE_PYTHON="$CLADE_REPO_DIR/.venv/bin/python"

if [[ ! -x "$CLADE_PYTHON" ]]; then
  echo "Error: clade-a2a not installed at $CLADE_REPO_DIR"
  echo "Run the install command from your setup server again."
  exit 1
fi

export CLADE_CONFIG="$(pwd)/{{ peer.peer_id }}.yaml"

if [[ ! -f "$CLADE_CONFIG" ]]; then
  echo "Error: config not found at $CLADE_CONFIG"
  exit 1
fi

echo "Starting Clade A2A daemon as '{{ peer.peer_id }}'..."
echo "  Config:  $CLADE_CONFIG"
echo "  Relay:   {{ setup.relay_url }}"
echo ""

exec "$CLADE_PYTHON" -m agent.daemon "$@"
