#!/bin/bash
# Clade A2A daemon start script for peer '{{ peer.peer_id }}' (v1.4.5+)
# Generated by Clade Setup Server.
#
# Prepoznaje vec-tekuci daemon i nudi restart (umesto da samo prepoznaje "ERROR
# drugi daemon vec tece" i izadje kao u v1.4.4).

set -e
cd "$(dirname "$0")"

CLADE_REPO_DIR="${CLADE_REPO_DIR:-/opt/clade-a2a}"
CLADE_PYTHON="$CLADE_REPO_DIR/.venv/bin/python"

if [[ ! -x "$CLADE_PYTHON" ]]; then
  echo "Error: clade-a2a not installed at $CLADE_REPO_DIR"
  echo "Run the install command from your setup server again."
  exit 1
fi

export CLADE_CONFIG="$(pwd)/{{ peer.peer_id }}.yaml"

if [[ ! -f "$CLADE_CONFIG" ]]; then
  echo "Error: config not found at $CLADE_CONFIG"
  exit 1
fi

# v1.4.5: provera postojeceg daemon-a (file lock je u ~/.clade/<peer>-daemon.lock).
# Ako stari tece, ponudi restart (interaktivno) ili sa --restart flag-om.
LOCK_FILE="${HOME}/.clade/{{ peer.peer_id }}-daemon.lock"
RESTART=""
NEW_ARGS=()
for a in "$@"; do
  if [[ "$a" == "--restart" ]]; then
    RESTART=1
  else
    NEW_ARGS+=("$a")
  fi
done
set -- "${NEW_ARGS[@]}"

if [[ -f "$LOCK_FILE" ]]; then
  OLD_PID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
  if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
    echo "Daemon za '{{ peer.peer_id }}' vec tece (PID $OLD_PID)."
    if [[ -z "$RESTART" ]]; then
      if [[ -t 0 ]]; then
        read -r -p "Restart? [y/N] " ans
        [[ "$ans" =~ ^[Yy] ]] || { echo "Abort."; exit 1; }
      else
        echo "Non-interactive shell. Pokreni sa --restart da automatski zameniš."
        exit 1
      fi
    fi
    echo "  Gasim stari (PID $OLD_PID)..."
    kill -TERM "$OLD_PID" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "$OLD_PID" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$OLD_PID" 2>/dev/null; then
      echo "  SIGTERM nije pomoglo — SIGKILL."
      kill -KILL "$OLD_PID" 2>/dev/null || true
    fi
    sleep 1
    rm -f "$LOCK_FILE"
  fi
fi

echo "Starting Clade A2A daemon as '{{ peer.peer_id }}'..."
echo "  Config:  $CLADE_CONFIG"
echo "  Relay:   {{ setup.relay_url }}"
echo ""

exec "$CLADE_PYTHON" -m agent.daemon "$@"
