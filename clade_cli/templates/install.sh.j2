#!/bin/bash
# Clade A2A install script for peer '{{ peer.peer_id }}' ({{ peer.display_name }})
# Generated by Clade Setup Server. Safe to re-run (idempotent).

set -e

PEER_ID="{{ peer.peer_id }}"
DISPLAY_NAME="{{ peer.display_name }}"
RELAY_URL="{{ setup.relay_url }}"
SETUP_URL="{{ public_url_base }}"
DOWNLOAD_TOKEN="{{ peer.download_token }}"

CLADE_REPO_URL="https://github.com/inter-coder/clade-a2a.git"
CLADE_REPO_DIR="${CLADE_REPO_DIR:-/opt/clade-a2a}"
AGENT_DIR="${AGENT_DIR:-$HOME/clade-agent}"

# --- Pretty output ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}==>${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
fail()  { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

echo ""
echo -e "${BOLD}Clade A2A — Install for peer '${PEER_ID}'${NC}"
echo "------------------------------------------------"
echo ""

# --- Prerequisites ---
info "Checking prerequisites..."
command -v git > /dev/null || fail "git not installed. Install it first (e.g. 'sudo apt install git' or 'brew install git')"
command -v curl > /dev/null || fail "curl not installed"
ok "git, curl available"

# --- Install uv if missing ---
UV="${HOME}/.local/bin/uv"
if [[ ! -x "$UV" ]] && ! command -v uv > /dev/null; then
  info "Installing uv (Python package manager)..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  if [[ ! -x "$UV" ]]; then
    fail "uv install failed; please install manually: https://docs.astral.sh/uv/"
  fi
  ok "uv installed at $UV"
else
  ok "uv already available"
fi

# --- Clone + install clade-a2a ---
# v1.10.1: koristimo `git fetch + reset --hard origin/master` umesto `git pull
# --ff-only` jer ff-only tiho failuje kad je local divergent (npr. ostao na
# revertovanom commit-u koji ne postoji vise na origin-u). Posledica je da
# install nastavi sa starim kodom — daemon bez presence_loop-a, MCP bez
# clade_peers itd. — peer-ovi se nikad ne vide. /opt/clade-a2a je deploy
# artifact, ne dev clone, pa hard reset je tacan pristup.
NEEDS_REINSTALL=0
if [[ ! -d "$CLADE_REPO_DIR" ]]; then
  info "Cloning clade-a2a to $CLADE_REPO_DIR..."
  if [[ "$CLADE_REPO_DIR" == /opt/* ]] && [[ ! -w "$(dirname "$CLADE_REPO_DIR")" ]]; then
    sudo mkdir -p "$CLADE_REPO_DIR"
    sudo chown "$USER" "$CLADE_REPO_DIR"
  else
    mkdir -p "$CLADE_REPO_DIR"
  fi
  git clone "$CLADE_REPO_URL" "$CLADE_REPO_DIR"
  ok "clade-a2a cloned"
  NEEDS_REINSTALL=1
else
  info "clade-a2a directory exists, syncing to origin/master..."
  PRE_HEAD=$(cd "$CLADE_REPO_DIR" && git rev-parse HEAD 2>/dev/null || echo "")
  if ! (cd "$CLADE_REPO_DIR" && git fetch origin master 2>&1 | tail -5); then
    warn "git fetch failed; using existing checkout"
  else
    if ! (cd "$CLADE_REPO_DIR" && git reset --hard origin/master 2>&1 | tail -2); then
      warn "git reset --hard failed; using existing checkout"
    fi
  fi
  POST_HEAD=$(cd "$CLADE_REPO_DIR" && git rev-parse HEAD 2>/dev/null || echo "")
  if [[ -n "$PRE_HEAD" && "$PRE_HEAD" != "$POST_HEAD" ]]; then
    info "kod azuriran ($PRE_HEAD → $POST_HEAD), reinstall venv-a..."
    NEEDS_REINSTALL=1
  fi
fi

CLADE_PYTHON="$CLADE_REPO_DIR/.venv/bin/python"
if [[ ! -x "$CLADE_PYTHON" ]]; then
  info "Creating venv + installing clade-a2a..."
  (cd "$CLADE_REPO_DIR" && "$UV" venv && "$UV" pip install -e .)
  ok "clade-a2a installed"
elif [[ "$NEEDS_REINSTALL" == "1" ]]; then
  info "Re-running pip install -e . (pull-ovan nov kod)..."
  (cd "$CLADE_REPO_DIR" && "$UV" pip install -e .)
  ok "clade-a2a re-installed sa novim kodom"
else
  ok "clade-a2a venv exists at $CLADE_PYTHON (nije bilo promena)"
fi

# --- Download peer config + start script ---
# v1.10.1: per-peer named scripts (start-<peer>.sh, chat-<peer>.sh) umesto
# shared start.sh + chat.sh. Bez ovog, multi-peer setup na istoj masini
# overwrite-uje skripte — drugi install pregazi prvog peer-a start.sh, pa
# samo zadnji install ima funkcionalan entry point.
# Backward compat: pravimo simbolicke link-ove start.sh -> start-<last>.sh
# (i chat.sh) tako da single-peer setup-i nastave da rade kao do sad.
info "Downloading peer config + start script from $SETUP_URL..."
mkdir -p "$AGENT_DIR"
cd "$AGENT_DIR"

curl -fsSL -o "${PEER_ID}.yaml" "${SETUP_URL}/agent/${DOWNLOAD_TOKEN}/config"
chmod 600 "${PEER_ID}.yaml"
ok "Downloaded ${PEER_ID}.yaml (mode 0600)"

curl -fsSL -o "start-${PEER_ID}.sh" "${SETUP_URL}/agent/${DOWNLOAD_TOKEN}/start"
chmod +x "start-${PEER_ID}.sh"
ln -sf "start-${PEER_ID}.sh" "start.sh"
ok "Downloaded start-${PEER_ID}.sh (+ start.sh symlink for compat)"

curl -fsSL -o "chat-${PEER_ID}.sh" "${SETUP_URL}/agent/${DOWNLOAD_TOKEN}/chat"
chmod +x "chat-${PEER_ID}.sh"
ln -sf "chat-${PEER_ID}.sh" "chat.sh"
ok "Downloaded chat-${PEER_ID}.sh (+ chat.sh symlink for compat)"

# Create workdir with .mcp.json so Claude Code auto-discovers the agent
mkdir -p "workdir-${PEER_ID}"
curl -fsSL -o "workdir-${PEER_ID}/.mcp.json" "${SETUP_URL}/agent/${DOWNLOAD_TOKEN}/mcp-config"

# Substitute $HOME placeholder so the path is concrete on this machine.
# Note: in bash double-quotes, \\$HOME becomes \$HOME (literal), which sed
# never matches against the actual `$HOME` string in the file. Use a
# different delimiter (#) and \$ inside double quotes so bash leaves the
# dollar alone and sed sees `$HOME` as a literal pattern.
sed -i.bak "s#\$HOME/clade-agent#${AGENT_DIR}#g" "workdir-${PEER_ID}/.mcp.json"
rm -f "workdir-${PEER_ID}/.mcp.json.bak"
# Sanity: $HOME placeholder must be gone. If sed silently no-op-ed, the MCP
# server would fail to load CLADE_CONFIG with cryptic -32000 error in claude /mcp.
if grep -q '\$HOME' "workdir-${PEER_ID}/.mcp.json"; then
  fail "sed substitution failed: \$HOME placeholder still in workdir-${PEER_ID}/.mcp.json"
fi
ok "Created workdir-${PEER_ID}/ with .mcp.json (CLADE_CONFIG=${AGENT_DIR}/${PEER_ID}.yaml)"

# --- Sanity check: can we reach the relay? ---
info "Verifying relay reachability..."
if curl -sf --max-time 5 "${RELAY_URL}/health" > /dev/null; then
  ok "Relay is reachable at $RELAY_URL"
else
  warn "Relay not reachable at $RELAY_URL — check that it's running and firewall allows access"
fi

# --- Done ---
echo ""
echo -e "${GREEN}${BOLD}Installation complete!${NC}"
echo ""
echo "  Peer ID:        $PEER_ID"
echo "  Display name:   $DISPLAY_NAME"
echo "  Config:         $AGENT_DIR/${PEER_ID}.yaml"
echo "  Relay:          $RELAY_URL"
echo ""
echo -e "${BOLD}Two terminals on this machine:${NC}"
echo ""
echo "  Terminal 1 (always-on daemon, auto-replies to incoming questions):"
echo "    $AGENT_DIR/start-${PEER_ID}.sh --yolo"
echo ""
echo "  Terminal 2 (when YOU want to send/ask other peers):"
echo "    $AGENT_DIR/chat-${PEER_ID}.sh"
echo "    # In Claude prompt: 'Ask <other-peer-name> ...'"
echo ""
echo "The daemon polls the relay every 2s and auto-replies via 'claude --print'."
echo "chat-${PEER_ID}.sh opens an interactive Claude session with clade_* MCP tools available."
echo ""
echo "Note: ako instaliras vise peer-ova na ISTU masinu, svaki dobija svoju"
echo "      start-<peer>.sh i chat-<peer>.sh — start.sh / chat.sh su symlink-ovi"
echo "      na ZADNJEG installed peer-a (backwards-compat za single-peer setup)."
echo ""
