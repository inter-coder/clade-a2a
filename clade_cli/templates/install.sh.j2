#!/bin/bash
# Clade A2A install script for peer '{{ peer.peer_id }}' ({{ peer.display_name }})
# Generated by Clade Setup Server. Safe to re-run (idempotent).

set -e

PEER_ID="{{ peer.peer_id }}"
DISPLAY_NAME="{{ peer.display_name }}"
RELAY_URL="{{ setup.relay_url }}"
SETUP_URL="{{ public_url_base }}"
DOWNLOAD_TOKEN="{{ peer.download_token }}"

CLADE_REPO_URL="https://github.com/inter-coder/clade-a2a.git"
CLADE_REPO_DIR="${CLADE_REPO_DIR:-/opt/clade-a2a}"
AGENT_DIR="${AGENT_DIR:-$HOME/clade-agent}"

# --- Pretty output ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}==>${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
fail()  { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

echo ""
echo -e "${BOLD}Clade A2A — Install for peer '${PEER_ID}'${NC}"
echo "------------------------------------------------"
echo ""

# --- Prerequisites ---
info "Checking prerequisites..."
command -v git > /dev/null || fail "git not installed. Install it first (e.g. 'sudo apt install git' or 'brew install git')"
command -v curl > /dev/null || fail "curl not installed"
ok "git, curl available"

# --- Install uv if missing ---
UV="${HOME}/.local/bin/uv"
if [[ ! -x "$UV" ]] && ! command -v uv > /dev/null; then
  info "Installing uv (Python package manager)..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  if [[ ! -x "$UV" ]]; then
    fail "uv install failed; please install manually: https://docs.astral.sh/uv/"
  fi
  ok "uv installed at $UV"
else
  ok "uv already available"
fi

# --- Clone + install clade-a2a ---
if [[ ! -d "$CLADE_REPO_DIR" ]]; then
  info "Cloning clade-a2a to $CLADE_REPO_DIR..."
  if [[ "$CLADE_REPO_DIR" == /opt/* ]] && [[ ! -w "$(dirname "$CLADE_REPO_DIR")" ]]; then
    sudo mkdir -p "$CLADE_REPO_DIR"
    sudo chown "$USER" "$CLADE_REPO_DIR"
  else
    mkdir -p "$CLADE_REPO_DIR"
  fi
  git clone "$CLADE_REPO_URL" "$CLADE_REPO_DIR"
  ok "clade-a2a cloned"
else
  info "clade-a2a directory exists, pulling latest..."
  (cd "$CLADE_REPO_DIR" && git pull --ff-only) || warn "git pull failed; using existing checkout"
fi

CLADE_PYTHON="$CLADE_REPO_DIR/.venv/bin/python"
if [[ ! -x "$CLADE_PYTHON" ]]; then
  info "Creating venv + installing clade-a2a..."
  (cd "$CLADE_REPO_DIR" && "$UV" venv && "$UV" pip install -e .)
  ok "clade-a2a installed"
else
  ok "clade-a2a venv exists at $CLADE_PYTHON"
fi

# --- Download peer config + start script ---
info "Downloading peer config + start script from $SETUP_URL..."
mkdir -p "$AGENT_DIR"
cd "$AGENT_DIR"

curl -fsSL -o "${PEER_ID}.yaml" "${SETUP_URL}/agent/${DOWNLOAD_TOKEN}/config"
chmod 600 "${PEER_ID}.yaml"
ok "Downloaded ${PEER_ID}.yaml (mode 0600)"

curl -fsSL -o "start.sh" "${SETUP_URL}/agent/${DOWNLOAD_TOKEN}/start"
chmod +x "start.sh"
ok "Downloaded start.sh"

# --- Sanity check: can we reach the relay? ---
info "Verifying relay reachability..."
if curl -sf --max-time 5 "${RELAY_URL}/health" > /dev/null; then
  ok "Relay is reachable at $RELAY_URL"
else
  warn "Relay not reachable at $RELAY_URL — check that it's running and firewall allows access"
fi

# --- Done ---
echo ""
echo -e "${GREEN}${BOLD}Installation complete!${NC}"
echo ""
echo "  Peer ID:        $PEER_ID"
echo "  Display name:   $DISPLAY_NAME"
echo "  Config:         $AGENT_DIR/${PEER_ID}.yaml"
echo "  Relay:          $RELAY_URL"
echo ""
echo -e "${BOLD}Start the agent:${NC}"
echo ""
echo "  $AGENT_DIR/start.sh           # safe mode"
echo "  $AGENT_DIR/start.sh --yolo    # skip permission prompts (for tool use)"
echo ""
echo "The daemon will poll the relay every 2s and auto-reply to questions"
echo "from other peers via 'claude --print'. Press Ctrl+C to stop."
echo ""
