#!/bin/bash
# Clade A2A — Interactive Claude session for peer '{{ peer.peer_id }}' ({{ peer.display_name }})
# v1.4.6+: pre exec claude, fetch live peer status iz relay-a + ucitava peer
# listu iz lokalnog yaml-a, inject u --append-system-prompt da Claude ZNA ko je
# u mrezi i ko je online.
#
# U promptu, pricaj prirodno:
#   > Pitaj {{ other_sample_name }} koliko je 7 puta 8
#   > Reci {{ other_sample_name }} da je deploy gotov
#
# Claude mapira na clade_message automatski.

set -e

cd "$(dirname "$0")"
AGENT_DIR="$(pwd)"
WORKDIR="$AGENT_DIR/workdir-{{ peer.peer_id }}"
PEER_YAML="$AGENT_DIR/{{ peer.peer_id }}.yaml"
RELAY_URL="{{ setup.relay_url }}"
MY_ID="{{ peer.peer_id }}"
MY_NAME="{{ peer.display_name }}"

if ! command -v claude > /dev/null; then
  echo "Error: 'claude' command not found in PATH"
  echo "Install Claude Code first: https://docs.claude.com/claude-code"
  exit 1
fi

if [[ ! -d "$WORKDIR" ]]; then
  echo "Error: workdir not found at $WORKDIR"
  echo "Re-run install: curl -fsSL {{ public_url_base }}/agent/{{ peer.download_token }}/install | bash"
  exit 1
fi

if [[ ! -f "$WORKDIR/.mcp.json" ]]; then
  echo "Error: .mcp.json not found at $WORKDIR/.mcp.json"
  echo "Re-run install to regenerate."
  exit 1
fi

# v1.4.7: provera mog daemon-a preko lock fajla. Lock je u dirname(audit_db) iz
# yaml-a (ne hardkodirano ~/.clade — moze biti override-ovano).
LOCK_DIR=$(python3 -c "
import yaml, os
try:
    cfg = yaml.safe_load(open('$PEER_YAML'))
    db = cfg.get('audit_db', '~/.clade/${MY_ID}-audit.db')
    print(os.path.dirname(os.path.expanduser(db)))
except Exception:
    print(os.path.expanduser('~/.clade'))
" 2>/dev/null)
LOCK_DIR="${LOCK_DIR:-$HOME/.clade}"
LOCK_FILE="${LOCK_DIR}/${MY_ID}-daemon.lock"
DAEMON_STATUS="offline"
if [[ -f "$LOCK_FILE" ]]; then
  DPID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
  if [[ -n "$DPID" ]] && kill -0 "$DPID" 2>/dev/null; then
    DAEMON_STATUS="online (PID $DPID)"
  fi
fi
if [[ "$DAEMON_STATUS" == "offline" ]]; then
  echo "Warning: tvoj daemon ('${MY_ID}') NIJE pokrenut."
  echo "Bez njega ostali peer-i ne mogu da te pitaju nista (samo ti njih)."
  echo "Pokreni u drugom terminalu: $AGENT_DIR/start.sh --yolo"
  echo ""
fi

# v1.8.0: pitaj relay ko je STVARNO online (presence heartbeat track-er).
# Pre v1.8.0: known_agents iz /health = ima validan token, NE = daemon tece.
# Sad: GET /presence vraca {peer: {online, secs_ago}} — online znaci da je
# peer-ov daemon poslao heartbeat u zadnjih ~30s.
BEARER_TOKEN=$(python3 -c "
import yaml
try:
    print(yaml.safe_load(open('$PEER_YAML')).get('bearer_token', ''))
except Exception:
    print('')
" 2>/dev/null)
ONLINE_PEERS=""
OFFLINE_PEERS=""
PEER_STATUS_JSON=""
if [[ -n "$BEARER_TOKEN" ]]; then
  PEER_STATUS_JSON=$(curl -sf --max-time 3 \
    -H "Authorization: Bearer $BEARER_TOKEN" \
    "${RELAY_URL}/presence" 2>/dev/null || echo "")
  if [[ -n "$PEER_STATUS_JSON" ]]; then
    ONLINE_PEERS=$(echo "$PEER_STATUS_JSON" | python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
  print(','.join(sorted(p for p, s in d.get('peers', {}).items() if s.get('online'))))
except Exception:
  pass
" 2>/dev/null || echo "")
    OFFLINE_PEERS=$(echo "$PEER_STATUS_JSON" | python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
  print(','.join(sorted(p for p, s in d.get('peers', {}).items() if not s.get('online'))))
except Exception:
  pass
" 2>/dev/null || echo "")
  fi
fi

# v1.4.8: ucitaj pending send-ove iz audit DB-a (thread_history) od last_seen
# vremena. Bez ovog, send poruke (fire-and-forget) su nevidljive user-u —
# bob daemon ih samo log-uje, nigde se ne prikazu kad user otvori chat.sh.
LAST_SEEN_FILE="${AGENT_DIR}/.chat_last_seen_${MY_ID}"
LAST_SEEN_MS=$(cat "$LAST_SEEN_FILE" 2>/dev/null || echo "0")
# Odredi audit DB put iz yaml-a
AUDIT_DB=$(python3 -c "
import yaml, os
try:
    cfg = yaml.safe_load(open('$PEER_YAML'))
    print(os.path.expanduser(cfg.get('audit_db', '~/.clade/${MY_ID}-audit.db')))
except Exception:
    print(os.path.expanduser('~/.clade/${MY_ID}-audit.db'))
" 2>/dev/null)
PENDING_SENDS=""
if [[ -f "$AUDIT_DB" ]]; then
  PENDING_SENDS=$(python3 -c "
import sqlite3, json, sys
try:
    c = sqlite3.connect('$AUDIT_DB')
    # v1.4.8: send-ovi su u 'audit' tabeli (note kolona ima JSON payload),
    # ne u 'thread_history' (koja zahteva _thread_id tag).
    rows = c.execute('''
        SELECT ts_ms, peer, note
        FROM audit
        WHERE direction='in' AND kind='send' AND ts_ms > ?
        ORDER BY ts_ms ASC LIMIT 20
    ''', (${LAST_SEEN_MS},)).fetchall()
    if not rows:
        sys.exit(0)
    import datetime as _dt
    out = []
    for ts, peer, note in rows:
        try:
            p = json.loads(note or '{}')
            text = p.get('text') or json.dumps({k:v for k,v in p.items() if not k.startswith('_')}, ensure_ascii=False)[:120]
        except Exception:
            text = (note or '')[:120]
        when = _dt.datetime.fromtimestamp(ts/1000).strftime('%m-%d %H:%M')
        out.append(f'  [{when}] {peer}: {text}')
    print(chr(10).join(out))
except Exception as e:
    print(f'  (nije moglo da se procita audit: {e})', file=sys.stderr)
" 2>/dev/null)
fi
# Pisi sada kao novi last_seen (sledeci put nece prikazati ove)
date +%s%3N > "$LAST_SEEN_FILE" 2>/dev/null

# v1.8.0: peer directory sa LIVE statusom (online/offline iz /presence)
PEER_DIRECTORY=""
if [[ -f "$PEER_YAML" ]]; then
  PEER_DIRECTORY=$(python3 -c "
import sys, yaml, json
try:
  with open('$PEER_YAML') as f:
    cfg = yaml.safe_load(f)
  online = set('${ONLINE_PEERS}'.split(',')) if '${ONLINE_PEERS}' else set()
  offline = set('${OFFLINE_PEERS}'.split(',')) if '${OFFLINE_PEERS}' else set()
  known = online | offline
  # secs_ago iz JSON-a (ako imamo)
  secs_map = {}
  try:
    d = json.loads('''${PEER_STATUS_JSON}''') if '${PEER_STATUS_JSON}' else {}
    for p, s in d.get('peers', {}).items():
      secs_map[p] = s.get('secs_ago')
  except Exception:
    pass
  lines = []
  for pid, entry in (cfg.get('peers') or {}).items():
    if isinstance(entry, dict):
      name = entry.get('name') or pid
      role = (entry.get('role') or '').split(chr(10))[0][:80]
    else:
      name, role = pid, ''
    if pid in online:
      sa = secs_map.get(pid)
      sa_str = f', last seen {sa:.0f}s ago' if isinstance(sa, (int, float)) else ''
      status = f'ONLINE{sa_str}'
    elif pid in offline:
      sa = secs_map.get(pid)
      if sa is None:
        status = 'offline (daemon nikad nije starovao)'
      else:
        status = f'offline (last seen {sa:.0f}s ago, daemon zaglavljen ili mreza?)'
    elif not known:
      status = 'status nepoznat (relay /presence nedostupan)'
    else:
      status = 'NIJE u relay tokens (bug, prijavi)'
    line = f'  - {name} (id={pid}) — {status}'
    if role:
      line += f' [role: {role}]'
    lines.append(line)
  print(chr(10).join(lines))
except Exception as e:
  print(f'  (gresci u citanju peer-ova: {e})')
" 2>/dev/null || echo "  (nije moglo da se procita $PEER_YAML)")
fi

# Compose system prompt sa svim ovim
_PENDING_SECTION=""
if [[ -n "$PENDING_SENDS" ]]; then
  _PENDING_COUNT=$(echo "$PENDING_SENDS" | wc -l | tr -d ' ')
  _PENDING_SECTION="

PENDING SEND-OVI ($_PENDING_COUNT komada, od proslog otvaranja chat.sh-a) —
'tell me' poruke koje peer-ovi su poslali bez ocekivanja odgovora; user
nije znao da postoje dok nije otvorio chat.sh:
${PENDING_SENDS}

Korisnika ODMAH na pocetku obavesti da ima $_PENDING_COUNT novih poruka i
sumaraj ih jednom recenicom. Cekaj sta zeli da uradi sa njima."
fi

SYSTEM_PROMPT="Ti pomazes korisniku da komunicira preko Clade A2A mreze.

KORISNIK je peer '${MY_NAME}' (ID: ${MY_ID}). Daemon: ${DAEMON_STATUS}. Relay: ${RELAY_URL}.

Trenutno stanje (snapshot, presence TTL ~35s):
${PEER_DIRECTORY:-  (lista nedostupna)}${_PENDING_SECTION}

=== PRAVILA ODGOVORA (vazno — disciplina) ===

1. TERSE. Pitanje 'ko je u mrezi' = jedna recenica, NE ASCII tabla. Ako
   imas <=4 peer-a, formatiraj 'X (online), Y (offline)' — bez headers/tabela.
   Markdown tabla samo za >5 redova ili kad user explicitno trazi tabelu.

2. NE NUDI follow-up akcije ('Da pingnem?', 'Da pitam frontend?') osim ako
   user nije pitao. Cekaj sledece pitanje. Ako sumnjas — cuti.

3. NE SPEKULISI o stvarima koje user nije pitao (zaostali fajlovi na disku,
   istorija prethodnih sesija, hipotetski uzroci). Drzi se direktnog odgovora.

4. AKO MCP clade tool nije dostupan — JAVI 'clade MCP tool nije dostupan u
   ovoj sesiji, treba odobriti server'. NE pokusavaj raw HTTP fallback na
   relay (POST /peers / GET /health curl-om). Raw HTTP je gubljenje tokena
   i nema sve sto MCP tool ima (presence parsing, role lookup, audit).

5. AKO peer offline — kazi direktno 'X je offline, nije moguce poslati'.
   NE pokrecite spekulacije zasto je offline ako user nije pitao.

6. PRE NEGO sto pomislis 'idem da pomognem', proveri: da li user TRAZI to?
   Ako je pitanje 'ko je online?' — odgovor je jedna recenica. Ne pre-amble,
   ne TLDR sekcija, ne 'Ako hoces mogu...'.

=== MCP TOOL API ===

- Ko je online sada:               clade_peers()
- Pitaj peer-a (sinhrono):         clade_message(to='<id>', content='...', expect_reply=True)
- Posalji (fire-and-forget):       clade_message(to='<id>', content='...')
- Broadcast tim/listu:             clade_broadcast(to_team='...' ili to=[...], content='...')
- Delegiraj async task:            clade_task(to='<id>', brief='...')
- Status task-a:                   clade_task_status(task_id) / clade_task_list(filter='sent')
- Reply na ask:                    clade_reply(correlation_id, response, to)
- Pregled inbox:                   clade_inbox()  (busy ako daemon tece)

Mapping primer:
  'Ko je u mrezi?'         → clade_peers() → 'frontend online, backend offline.' [KRAJ]
  'Pitaj Charlie ...'      → clade_message(to='charlie', expect_reply=True)
  'Reci svima ...'         → clade_broadcast(to_team='everyone', ...)
  'Delegiraj Bobu zadatak X' → clade_task(to='bob', brief='X')

Ako 504 timeout — humani msg javlja sta nije radilo. Prenesi sazet, BEZ
predloga sledecih koraka osim ako user pita."

cd "$WORKDIR"
echo "Opening Claude in $WORKDIR..."
echo "Status: my daemon ${DAEMON_STATUS}"
if [[ -n "$ONLINE_PEERS" ]] || [[ -n "$OFFLINE_PEERS" ]]; then
  [[ -n "$ONLINE_PEERS" ]]  && echo "  online:  ${ONLINE_PEERS//,/, }"
  [[ -n "$OFFLINE_PEERS" ]] && echo "  offline: ${OFFLINE_PEERS//,/, }"
else
  echo "  presence: nedostupno (relay /presence ne odgovara)"
fi
echo ""
# v1.10.0: --allowedTools listanje svih clade_* tool-ova da se ne trazi
# permission approval pri prvom pozivu. Bez ovoga, Claude vidi MCP server
# kao 'Pending approval' i pokusava raw HTTP fallback (gubljenje tokena +
# greske jer relay nema sve endpoint-ove koje agent tools imitiraju).
# --permission-mode acceptEdits prosiruje na file Edit-ove (ne menja MCP).
CLADE_ALLOWED_TOOLS="mcp__clade__clade_message,mcp__clade__clade_send,mcp__clade__clade_ask,mcp__clade__clade_inbox,mcp__clade__clade_reply,mcp__clade__clade_outbox_status,mcp__clade__clade_peers,mcp__clade__clade_broadcast,mcp__clade__clade_task,mcp__clade__clade_task_update,mcp__clade__clade_task_status,mcp__clade__clade_task_list"
exec claude --append-system-prompt "$SYSTEM_PROMPT" --permission-mode acceptEdits --allowedTools "$CLADE_ALLOWED_TOOLS"
